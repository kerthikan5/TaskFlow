{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=taskflow.db"
  },
  "JwtSettings": {
    "Secret": "TASKFLOW_SUPER_SECRET_JWT_KEY_FOR_LOCAL_DEVELOPMENT_123456789",
    "Issuer": "TaskFlow.Api",
    "Audience": "TaskFlow.Client",
    "ExpiryMinutes": 120
  }
}
